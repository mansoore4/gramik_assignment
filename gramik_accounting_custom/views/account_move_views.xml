<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customer Invoice Form -->
    <record id="view_move_form_business_segment" model="ir.ui.view">
        <field name="name">account.move.form.business.segment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="business_segment"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

    <!-- Customer Invoice List -->
    <record id="view_move_tree_business_segment" model="ir.ui.view">
        <field name="name">account.move.list.business.segment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="business_segment"/>
            </xpath>
        </field>
    </record>

</odoo>
